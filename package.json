{
  "name": "yayasan-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "payload": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload",
    "migrate": "npm run payload -- migrate",
    "migrate:create": "npm run payload -- migrate:create --skip-empty",
    "migrate:status": "npm run payload -- migrate:status",
    "ci:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "@payloadcms/db-postgres": "^3.78.0",
    "@payloadcms/next": "^3.78.0",
    "@payloadcms/richtext-lexical": "^3.78.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.4.27",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "flowbite": "^4.0.1",
    "flowbite-react": "^0.12.17",
    "framer-motion": "^13.4.4",
    "lenis": "^1.3.26",
    "next": "16.3.6",
    "payload": "^3.78.0",
    "postcss": "8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "zod": "^3.25.76"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.2",
    "cross-env": "^7.0.3",
    "vitest": "^2.1.9"
  }
}
